# ─── MantleQuant Environment ────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Wallet (for agent writes to chain) ───────────────────────────────────────
# Your private key — keep this secret!
PRIVATE_KEY=0x_your_private_key_here

# ── Mantle Network ────────────────────────────────────────────────────────────
# Testnet (default):
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz

# Mainnet (when ready):
# MANTLE_RPC_URL=https://rpc.mantle.xyz
# MANTLE_MAINNET_RPC=https://rpc.mantle.xyz

# ── Deployed Contract Addresses (set after npm run deploy:testnet) ────────────
SIGNAL_REGISTRY_ADDRESS=0x_signal_registry_address_here
AGENT_NFT_ADDRESS=0x_agent_nft_address_here

# ── Optional: Block Explorer API key (for contract verification) ──────────────
# Get from https://explorer.mantle.xyz
MANTLE_EXPLORER_API_KEY=

# ── Agent Config ──────────────────────────────────────────────────────────────
# How often to run the analysis cycle (milliseconds). Default: 3600000 (1 hour)
INTERVAL_MS=3600000

# ── Gas ───────────────────────────────────────────────────────────────────────
# Leave blank to use auto gas estimation
# GAS_PRICE_GWEI=0.05
