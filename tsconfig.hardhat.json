{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "CommonJS",
    "moduleResolution": "node",
    "lib":              ["ES2022"],
    "strict":           true,
    "esModuleInterop":  true,
    "resolveJsonModule": true,
    "types":            ["node"]
  },
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "typechain-types/**/*.ts"
  ]
}
